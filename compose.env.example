# Copy to compose.env and pass --env-file compose.env explicitly.
# This must be a database reachable FROM THE CONTAINER, not container localhost.
# Single quotes keep dollar signs in credentials literal to Compose.
DATABASE_URL='postgres://USER:PASSWORD@DB_HOST:5432/TEST_DB?sslmode=verify-full'
ALTASCI_PUBLIC_URL=https://tunnel.example.com
ALTASCI_VERSION=dev
# Host ports used by your existing reverse proxy. Container ports stay fixed.
ALTASCI_BIND_IP=127.0.0.1
ALTASCI_EDGE_PORT=18080
ALTASCI_CONTROL_PORT=18081
