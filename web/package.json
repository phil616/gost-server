  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components"
