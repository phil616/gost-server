{
  "name": "altasci-console",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "@phil616",
  "scripts": {
    "dev": "max dev",
    "build": "max build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@ant-design/pro-components": "3.1.14-2",
    "@umijs/max": "4.7.28",
    "antd": "6.6.8",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components",
      "axios": "0.34.0"
    },
    "dva-immer": {
      "immer": "9.0.21"
    },
    "@babel/core": "7.29.6",
    "@babel/runtime": "7.29.10",
    "@umijs/bundler-vite": {
      "vite": "7.3.7"
    },
    "@umijs/preset-umi": {
      "path-to-regexp": "1.9.0"
    },
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6",
    "fast-uri": "3.1.9",
    "postcss-selector-parser@<6.1.5": "6.1.5"
  }
}
